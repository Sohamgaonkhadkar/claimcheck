FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    CLAIMCHECK_ENV=production \
    CLAIMCHECK_STORAGE_ROOT=/var/lib/claimcheck/private-storage

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tesseract-ocr \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 claimcheck \
    && useradd --system --uid 10001 --gid claimcheck --home-dir /home/claimcheck \
       --create-home claimcheck \
    && mkdir -p /var/lib/claimcheck/private-storage \
    && chown -R claimcheck:claimcheck /var/lib/claimcheck

COPY pyproject.toml ./
COPY src/ ./src/

RUN python -m pip install --no-cache-dir .

USER 10001:10001
STOPSIGNAL SIGTERM
CMD ["claimcheck-worker"]
