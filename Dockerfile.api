FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    CLAIMCHECK_ENV=production \
    CLAIMCHECK_STORAGE_ROOT=/var/lib/claimcheck/private-storage

WORKDIR /app

RUN groupadd --system --gid 10001 claimcheck \
    && useradd --system --uid 10001 --gid claimcheck --home-dir /home/claimcheck \
       --create-home claimcheck \
    && mkdir -p /var/lib/claimcheck/private-storage \
    && chown -R claimcheck:claimcheck /var/lib/claimcheck

COPY pyproject.toml ./
COPY src/ ./src/
COPY migrations/ ./migrations/
COPY alembic.ini ./

RUN python -m pip install --no-cache-dir .

USER 10001:10001
EXPOSE 8000

# Liveness only. Route the platform's readiness probe to /readyz so PostgreSQL and
# private storage are checked before the instance receives traffic.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=3).read()" || exit 1

STOPSIGNAL SIGTERM
CMD ["uvicorn", "claimcheck.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
