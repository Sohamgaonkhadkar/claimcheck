# Copy to .env for local use, replace the development password, and never commit .env.
# This template contains placeholders only. Production secrets belong in a secret manager.

# LOCAL DEVELOPMENT — Compose PostgreSQL + fixed server-side development identity.
CLAIMCHECK_ENV=development
POSTGRES_DB=claimcheck
POSTGRES_USER=claimcheck_dev
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_RANDOM_PASSWORD
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://claimcheck_dev:REPLACE_WITH_LOCAL_RANDOM_PASSWORD@127.0.0.1:5432/claimcheck
CLAIMCHECK_STORAGE_ROOT=./runtime/private-storage
CLAIMCHECK_MAX_UPLOAD_BYTES=26214400
CLAIMCHECK_MAX_REQUEST_BYTES=27262976
CLAIMCHECK_MAX_PDF_PAGES=250
CLAIMCHECK_OCR_ENABLED=true
CLAIMCHECK_CORS_ORIGINS=
# Optional fixed local identity override; never use as production authentication.
# CLAIMCHECK_DEV_OWNER_ID=a7de45b2-26b7-4ad6-83b7-3d4784f5e61a
# Optional stable worker label; otherwise the process creates one.
# CLAIMCHECK_WORKER_ID=worker-local-1
CLAIMCHECK_WORKER_POLL_SECONDS=1
CLAIMCHECK_WORKER_LEASE_SECONDS=300
CLAIMCHECK_WORKER_HEARTBEAT_SECONDS=30
CLAIMCHECK_WORKER_RETRY_SECONDS=30
CLAIMCHECK_LOG_LEVEL=INFO

# TEST — use a separate disposable PostgreSQL database; never reuse local or production data.
# CLAIMCHECK_TEST_DATABASE_URL=postgresql+psycopg://test_user:REPLACE_WITH_TEST_SECRET@127.0.0.1:5432/claimcheck_test
# DATABASE_URL=postgresql+psycopg://test_user:REPLACE_WITH_TEST_SECRET@127.0.0.1:5432/claimcheck_test

# PRODUCTION — do not use the development identity or Compose credentials.
# CLAIMCHECK_ENV=production
# DATABASE_URL=postgresql+psycopg://DB_USER:INJECT_FROM_SECRET_MANAGER@DB_HOST:5432/DB_NAME
# CLAIMCHECK_STORAGE_ROOT=/var/lib/claimcheck/private-storage
# CLAIMCHECK_CORS_ORIGINS=https://app.example.com
# CLAIMCHECK_OCR_ENABLED=true
